# Copy this file to .env and replace every CHANGE_ME value with a unique secret.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sae_web
MYSQL_USER=sae_app
MYSQL_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=1d

# Public URL used by the browser and embedded at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost:3305/api
NEXTAUTH_URL=http://localhost:3303
NEXTAUTH_SECRET=

CORS_ORIGINS=http://localhost:3303

TZ=America/Argentina/Buenos_Aires
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 0 * * *

# Optional SMTP settings for backup notifications.
MAIL_SENDER=
MAIL_RECEIVER=
MAIL_PASSWORD=
MAIL_SERVER=
