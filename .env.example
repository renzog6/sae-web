# Variables de SAE-Web
# Copiar este archivo a .env y completar los valores.

# MySQL
DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sae_web
MYSQL_USER=sae_app
MYSQL_PASSWORD=

# Backend
JWT_SECRET=
JWT_EXPIRATION=1d
API_PREFIX=api
PORT=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3305/api
NEXTAUTH_URL=http://localhost:3303
NEXTAUTH_SECRET=

# CORS: origins permitidos, separados por comas
CORS_ORIGINS=http://localhost:3303

# Zona horaria
TZ=America/Argentina/Buenos_Aires

# Backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 0 * * *

# Notificaciones por correo
MAIL_SENDER=
MAIL_RECEIVER=
MAIL_PASSWORD=
MAIL_SERVER=
